# FastAPI App Settings
SECRET_KEY=supersecretjwtkeythatshouldbechangedinproduction12345
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# For local testing, SQLite is supported out-of-the-box. Change to PostgreSQL in production.
DATABASE_URL=sqlite:///./resume_platform.db
# DATABASE_URL=postgresql://user:password@localhost:5432/resume_platform

# AI Integration APIs
GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# n8n Integration Webhook Targets
N8N_RESUME_UPLOAD_WEBHOOK=http://localhost:5678/webhook/resume-upload
N8N_ATS_MONITORING_WEBHOOK=http://localhost:5678/webhook/ats-monitor
N8N_APPLICATION_WEBHOOK=http://localhost:5678/webhook/app-tracking
